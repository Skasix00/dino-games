{
	"name": "dino-games",
	"version": "1.0.0",
	"private": true,
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"typecheck": "next typegen && tsc --noEmit",
		"lint": "eslint .",
		"test": "vitest run",
		"test:e2e": "playwright test",
		"seed": "tsx --env-file-if-exists=.env scripts/seed-questions.ts",
		"test:browser": "tsx scripts/run-browser-tests.ts",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check ."
	},
	"dependencies": {
		"mongodb": "^7.7.0",
		"next": "^16.4.1",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"server-only": "^0.0.1",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@playwright/test": "^1.64.1",
		"@stylistic/eslint-plugin": "^5.10.0",
		"@tailwindcss/postcss": "^4.3.3",
		"@types/node": "^26.6.5",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"esbuild": "^0.28.2",
		"eslint": "^9.39.5",
		"eslint-config-next": "^16.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-perfectionist": "^5.12.1",
		"mongodb-memory-server": "^11.3.0",
		"prettier": "^3.9.10",
		"tailwindcss": "^4.3.3",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"vitest": "^5.0.5"
	},
	"type": "module"
}
